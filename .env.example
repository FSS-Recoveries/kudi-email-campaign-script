KUDI_API_KEY=your-kudi-api-key-here
SENDER_EMAIL=your-approved-sender-email@example.com
SENDER_NAME=Your Approved Sender Name

# Not read from .env directly -- get_credentials() checks this env var first,
# falling back to a local service_account.json file if unset. On Render,
# paste the full contents of your GCP service account JSON key here.
GOOGLE_CREDENTIALS_JSON={"type": "service_account", "project_id": "...", ...}
